<%# locals: (bunq_item:, visible_accounts:) %>

<%= tag.div id: dom_id(bunq_item) do %>
  <%= render DS::Disclosure.new(variant: :card, open: true) do |disclosure| %>
    <% disclosure.with_summary_content do %>
      <div class="flex items-center justify-between gap-2 w-full">
        <div class="flex items-center gap-3">
          <%= icon "chevron-right", class: "group-open:rotate-90 motion-safe:transition-transform" %>
          <%= render ProviderLogo.new(provider_key: :bunq) %>
          <div class="text-sm">
            <p class="font-medium text-primary"><%= bunq_item.name %></p>
            <% if bunq_item.scheduled_for_deletion? %>
              <p class="text-destructive"><%= t(".deletion_in_progress") %></p>
            <% elsif bunq_item.syncing? %>
              <p class="text-secondary"><%= t(".syncing") %></p>
            <% elsif bunq_item.sync_error.present? %>
              <%= render DS::Tooltip.new(text: bunq_item.sync_error, icon: "alert-circle", color: "destructive", as: :span) %>
              <span class="text-destructive"><%= t(".error") %></span>
            <% elsif bunq_item.last_synced_at %>
              <p class="text-secondary"><%= t(".status", timestamp: time_ago_in_words(bunq_item.last_synced_at)) %></p>
            <% else %>
              <p class="text-secondary"><%= t(".status_never") %></p>
            <% end %>
          </div>
        </div>

        <% if Current.user&.admin? %>
          <%= render DS::Menu.new do |menu| %>
            <% sync_schedule_menu_item(menu, bunq_item) %>
            <% menu.with_item(variant: "button", text: t(".delete"), icon: "trash-2",
                              href: bunq_item_path(bunq_item), method: :delete,
                              confirm: CustomConfirm.for_resource_deletion(bunq_item.name, high_severity: true)) %>
          <% end %>
        <% end %>
      </div>
    <% end %>

    <% unless bunq_item.scheduled_for_deletion? %>
      <div class="space-y-4 mt-4">
        <% if visible_accounts.any? %>
          <%= render "accounts/index/account_groups", accounts: visible_accounts %>
        <% end %>
        <% if Current.user&.admin? || visible_accounts.size == bunq_item.accounts.size %>
          <%= render ProviderSyncSummary.new(
                stats: @bunq_sync_stats_map&.fetch(bunq_item.id, {}) || {},
                provider_item: bunq_item,
                show_account_details: true,
                institutions_count: 1
              ) %>
        <% end %>
        <% if Current.user&.admin? && (bunq_item.unlinked_accounts_count.positive? || bunq_item.total_accounts_count.zero?) %>
          <%= render DS::Link.new(text: t(".setup_action"), icon: "settings", variant: "primary",
                                  href: setup_accounts_bunq_item_path(bunq_item), frame: :modal) %>
        <% end %>
      </div>
    <% end %>
  <% end %>
<% end %>
